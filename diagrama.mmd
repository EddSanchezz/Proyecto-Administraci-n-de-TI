graph TB

    INTERNET(("Internet"))
    DNS["DNS dinámico gratuito<br/>itec-quindio.duckdns.org"]

    subgraph RED["red local · 192.168.80.0/24 · modo bridged"]

        subgraph CLIENTES["clientes de la red"]
            SALAS["Salas de informática Linux<br/>estudiantes en formación técnica"]
            ADMON["Administración y secretaría<br/>PCs Windows"]
        end

        subgraph IMPRESORAS["impresoras"]
            P1["Impresora 1"]
            P2["Impresora 2"]
