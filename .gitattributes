# Normalizacion de finales de linea en todo el repositorio.
# Los scripts .sh, .conf, .sql, .php, .css, .yml y Dockerfile se guardan
# con finales LF en el repositorio y se extraen con LF en cualquier sistema,
# para que funcionen sin modificaciones dentro de la VM Ubuntu Server.

* text=auto

*.sh   text eol=lf
*.conf text eol=lf
*.sql  text eol=lf
*.php  text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.mmd  text eol=lf
Dockerfile text eol=lf

# Binarios: nunca normalizar
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.gz   binary
