# ============================================================================
# .env.example - Plantilla de variables de entorno de la pila web ITEC
# ----------------------------------------------------------------------------
# Proyecto Final - Administracion de Infraestructura de TI (Uniquindio 2026-1)
#
# USO: copie este archivo como .env (dentro de codigo/web/) y cambie las
# contrasenas ANTES de ejecutar docker compose up. El archivo .env esta en
# .gitignore y .dockerignore: no se sube al repositorio ni entra en la imagen.
#
# En Dokploy estos mismos valores se registran como variables de entorno
# de la aplicacion y de su base de datos PostgreSQL.
# ============================================================================

# Base de datos PostgreSQL de la aplicacion.
POSTGRES_DB=itec
POSTGRES_USER=itec_app
POSTGRES_PASSWORD=CambieEstaClavePorUnaSegura
